# Copy to backend/.env and fill in. Never commit the real file.
# Variables are added here as each checkpoint needs them.

# Checkpoint 3 — shared secret the mod uses to authenticate its WebSocket
# MACHIAVILLAGER_BRIDGE_TOKEN=

# Checkpoint 4 — LLM provider (any OpenAI-compatible endpoint)
# MACHIAVILLAGER_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# MACHIAVILLAGER_LLM_API_KEY=
# MACHIAVILLAGER_LLM_MODEL=

# Checkpoint 6 — persistence
# MACHIAVILLAGER_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/machiavillager

# Checkpoint 8 — voice
# MACHIAVILLAGER_AZURE_SPEECH_KEY=
# MACHIAVILLAGER_AZURE_SPEECH_REGION=
