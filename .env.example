# Copy to .env at the repo root (both the backend and the mod read it). Never commit the real file.
# Then generate your own bridge token (below). Everything else works as it is for local development.

# ── Bridge (Checkpoint 4) ────────────────────────────────────────────────────────────────────────────
# Shared secret the mod uses to authenticate its WebSocket. Each developer generates their own:
#   cd backend && uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# No token means the bridge stays off and the mod plays on its own.
MACHIAVILLAGER_BRIDGE_TOKEN=
# Where the mod connects. Default: ws://localhost:8000/bridge
# MACHIAVILLAGER_BRIDGE_URL=ws://localhost:8000/bridge

# ── Local development only (turn these off anywhere shared or deployed) ─────────────────────────────
# Mounts POST /dev/speak and POST /dev/chat so you can drive him from http://localhost:8000/docs.
MACHIAVILLAGER_DEV_ENDPOINTS=true
# He repeats each player chat line back, prefixed "(echo) ". A stand-in for the AI until Checkpoint 5.
MACHIAVILLAGER_DEV_ECHO=true
# Read by the mod: minimum seconds between unprompted speak actions. The design default is 180.
MACHIAVILLAGER_SPEECH_COOLDOWN_SECONDS=10
# Fixed in-game name for runClient, so your offline UUID never changes (letters, digits, _; max 16).
MACHIAVILLAGER_DEV_USERNAME=Dev

# ── Checkpoint 5: LLM provider (chosen in #11) ──────────────────────────────────────────────────────
# One key per provider; fill the ones you have. The chains below pick which one he uses in game.
# The compare script tests every provider that has a key.
# Groq (free, fastest): https://console.groq.com/keys
MACHIAVILLAGER_GROQ_API_KEY=
# NVIDIA Build (free credits, key starts with nvapi-): https://build.nvidia.com
MACHIAVILLAGER_NVIDIA_API_KEY=
# xAI Grok (paid, less filtered): https://console.x.ai
# MACHIAVILLAGER_XAI_API_KEY=
# Ordered provider:model pairs he tries left to right; pairs whose provider has no key are skipped.
# MACHIAVILLAGER_LLM_CHAIN=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b,nvidia:nvidia/nemotron-3.5-bolt-e4b
# Chain used when he is irritated; gpt-oss leads because it curses harder.
# MACHIAVILLAGER_LLM_CHAIN_IRRITATED=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,nvidia:nvidia/nemotron-3.5-bolt-e4b
# How crude he gets: off | mild | full. Default mild. full = profanity when irritated (opt-in servers).
# MACHIAVILLAGER_PROFANITY=mild

# ── Checkpoint 7: persistence ───────────────────────────────────────────────────────────────────────
# MACHIAVILLAGER_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/machiavillager

# ── Checkpoint 11: voice ────────────────────────────────────────────────────────────────────────────
# MACHIAVILLAGER_AZURE_SPEECH_KEY=
# MACHIAVILLAGER_AZURE_SPEECH_REGION=
